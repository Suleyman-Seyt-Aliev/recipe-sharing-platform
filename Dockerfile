# Берем легкую версию Node.js на базе Alpine Linux
FROM node:20-alpine

# Создаем рабочую папку внутри контейнера
WORKDIR /app

# Копируем только файлы с зависимостями
COPY package*.json ./

# Устанавливаем только те библиотеки, которые нужны для работы (без тестов и т.д.)
RUN npm ci --only=production

# Копируем весь остальной код проекта в контейнер
COPY . .

# Говорим, что контейнер будет слушать порт 3000
EXPOSE 3000

# Команда для запуска сервера
CMD ["node", "src/app.js"]